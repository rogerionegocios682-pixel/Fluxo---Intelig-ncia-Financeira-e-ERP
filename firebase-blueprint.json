{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile linked to an authenticated UID and company.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the user."
        },
        "companyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique company identifier."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "collaborator", "financeiro", "compras"],
          "description": "Role and access level within the company."
        },
        "department": {
          "type": "string",
          "maxLength": 100,
          "description": "Department or operational unit."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation."
        }
      },
      "required": ["email", "name", "companyId", "role"]
    },
    "Company": {
      "title": "Company",
      "description": "Company entity defining financial rules, limits, and profile.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique company identifier."
        },
        "name": {
          "type": "string",
          "maxLength": 150,
          "description": "Company legal or trade name."
        },
        "tradeName": {
          "type": "string",
          "maxLength": 150,
          "description": "Commercial fantasy name."
        },
        "cnpj": {
          "type": "string",
          "maxLength": 30,
          "description": "Brazilian CNPJ registration code."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact telephone or WhatsApp."
        },
        "address": {
          "type": "string",
          "maxLength": 255,
          "description": "Company physical address."
        },
        "city": {
          "type": "string",
          "maxLength": 100,
          "description": "City location."
        },
        "state": {
          "type": "string",
          "maxLength": 10,
          "description": "Federation state unit code."
        },
        "logo": {
          "type": "string",
          "description": "Company logo data URI or URL."
        },
        "dailyLimit": {
          "type": "number",
          "description": "Suggested maximum daily payout limit."
        },
        "monthlyLimit": {
          "type": "number",
          "description": "Monthly payout threshold."
        },
        "protectedDay": {
          "type": "number",
          "description": "Protected monthly day (e.g. 20 for payroll)."
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of company owner/creator."
        },
        "collaboratorUids": {
          "type": "array",
          "description": "List of user UIDs authorized to access this company database."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of company creation."
        }
      },
      "required": ["id", "name", "dailyLimit", "protectedDay", "ownerUid"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Bill or payment slip obligation registered in Accounts Payable.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique bill ID."
        },
        "purchaseId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional originating purchase ID."
        },
        "companyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Company ID owner of this bill."
        },
        "supplierId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional supplier ID."
        },
        "supplierName": {
          "type": "string",
          "maxLength": 150,
          "description": "Supplier or payee name."
        },
        "desc": {
          "type": "string",
          "maxLength": 255,
          "description": "Description of the bill or service."
        },
        "amount": {
          "type": "number",
          "description": "Financial monetary value in BRL."
        },
        "dueDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Maturity due date in YYYY-MM-DD format."
        },
        "status": {
          "type": "string",
          "enum": ["Pendente", "Pago", "Atrasado", "Cancelado"],
          "description": "Payment resolution status."
        },
        "paidAt": {
          "type": "string",
          "maxLength": 30,
          "description": "Date when payment was settled."
        },
        "paidAmount": {
          "type": "number",
          "description": "Settled paid amount in BRL."
        },
        "parcel": {
          "type": "string",
          "maxLength": 20,
          "description": "Installment fraction identifier (e.g. 1/3)."
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Expense category."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Additional notes."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation."
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of user who launched the bill."
        }
      },
      "required": ["id", "companyId", "supplierName", "desc", "amount", "dueDate", "status"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Simulated or actual commercial purchase with term breakdown.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique purchase ID."
        },
        "companyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Company ID owner."
        },
        "supplierId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional supplier ID."
        },
        "supplierName": {
          "type": "string",
          "maxLength": 150,
          "description": "Supplier name."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total purchase value in BRL."
        },
        "date": {
          "type": "string",
          "maxLength": 20,
          "description": "Base date of the order."
        },
        "termsSelected": {
          "type": "array",
          "description": "Selected term intervals in days."
        },
        "installmentsCount": {
          "type": "number",
          "description": "Number of generated installment bills."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Order notes or PO number."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of purchase recording."
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of user who launched the purchase."
        }
      },
      "required": ["id", "companyId", "supplierName", "totalAmount", "date", "installmentsCount"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Registered partner supplier.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique supplier ID."
        },
        "companyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Company ID owner."
        },
        "name": {
          "type": "string",
          "maxLength": 150,
          "description": "Supplier business name."
        },
        "cnpj": {
          "type": "string",
          "maxLength": 30,
          "description": "Supplier CNPJ."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact phone."
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Supplier primary category."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation."
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of user who registered the supplier."
        }
      },
      "required": ["id", "companyId", "name"]
    },
    "Collaborator": {
      "title": "Collaborator",
      "description": "Collaborator profile registered within a company.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique collaborator record ID."
        },
        "companyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Company ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Collaborator email."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Collaborator name."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "collaborator", "financeiro", "compras"],
          "description": "Collaborator assigned role."
        },
        "department": {
          "type": "string",
          "maxLength": 100,
          "description": "Department name."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of invitation or creation."
        },
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional mapped Firebase Auth UID."
        }
      },
      "required": ["id", "companyId", "email", "name", "role"]
    },
    "MasterAuditLog": {
      "title": "MasterAuditLog",
      "type": "object",
      "description": "Administrative audit trail log for master actions.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetStoreId": { "type": "string" },
        "targetStoreName": { "type": "string" },
        "targetUserId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "action", "createdAt"]
    }
  },
  "firestore": {
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/MasterAuditLog" },
      "description": "Administrative audit trail logs for master operations."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document keyed by auth UID."
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Company root document containing company settings and financial parameters."
    },
    "/companies/{companyId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/Bill" },
      "description": "Bills and payment slips collection for a specific company."
    },
    "/companies/{companyId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Purchases collection for a specific company."
    },
    "/companies/{companyId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Suppliers collection for a specific company."
    },
    "/companies/{companyId}/collaborators/{collaboratorId}": {
      "schema": { "$ref": "#/entities/Collaborator" },
      "description": "Collaborator roster collection for a specific company."
    }
  }
}
